# Copy to .env and fill in. Never commit .env.

# Hostinger account that hosts volcano.magikh0e.com (hPanel -> Advanced -> SSH Access).
VOLCANO_DEPLOY_HOST=u000000000@0.0.0.0
VOLCANO_DEPLOY_PORT=65002
VOLCANO_DEPLOY_KEY=~/.ssh/id_hostinger_volcano

# The site's public_html. The account hosts other sites and the deploy uses
# --delete-after, so tools/deploy.py only accepts .../domains/volcano.magikh0e.com/public_html/.
VOLCANO_DEPLOY_PATH=/home/u000000000/domains/volcano.magikh0e.com/public_html/

# Optional, only while the record is proxied through Cloudflare: the magikh0e.com zone
# and a token with Cache Purge on it.
# VOLCANO_CF_ZONE_ID=
# VOLCANO_CF_API_TOKEN=
