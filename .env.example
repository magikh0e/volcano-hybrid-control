# Copy to .env and fill in. Never commit .env.
# Anything left unset here is read from ../magikh0e-website/.env
# (DEPLOY_HOST, DEPLOY_PORT, DEPLOY_KEY, CF_ZONE_ID, CF_API_TOKEN).

# Required: the volcano.magikh0e.pl docroot on the server.
# NOT the main site's /var/www/html/ -- the deploy uses --delete-after.
VOLCANO_DEPLOY_PATH=
